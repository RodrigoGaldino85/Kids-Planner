PORT=3000
# PIN usado para proteger a área dos pais (cadastro de atividades e pagamentos)
ADMIN_PIN=1234
# Opcional: pasta onde o banco SQLite é salvo. Deixe vazio para usar ./data
# (padrão local). Em PaaS como Azure App Service, aponte para o disco
# persistente, ex: DATA_DIR=/home/data
DATA_DIR=
